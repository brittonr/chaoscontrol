     #[test]
+    fn pathless_git_ids_round_trip_with_explicit_names() {
+        const REVISION: &str = "ab123e3673b6dd616b3df5d044026b5e85755149";
+        const VERSION: &str = "0.1.0";
+        let url = Url::parse("rad://z2QJLUqyAZnnHPiZQ1BFjLsX9ush3").unwrap();
+        assert_eq!(url.path_segments().and_then(|mut p| p.next_back()), None);
+        let package = PackageIdSpec::new("vm-cohort-core".to_owned())
+            .with_url(url)
+            .with_version(VERSION.parse().unwrap())
+            .with_kind(SourceKind::Git(GitReference::Rev(REVISION.to_owned())));
+        let rendered = format!(
+            "git+rad://z2QJLUqyAZnnHPiZQ1BFjLsX9ush3?rev={REVISION}#vm-cohort-core@{VERSION}"
+        );
+        assert_eq!(package.to_string(), rendered);
+        assert_eq!(PackageIdSpec::parse(&rendered).unwrap(), package);
+        assert_eq!(
+            serde_json::to_string(&package).unwrap(),
+            format!("\"{rendered}\"")
+        );
+        assert_eq!(
+            PackageIdSpec::parse("git+rad://fixture#named")
+                .unwrap()
+                .name(),
+            "named"
+        );
+    }
+
