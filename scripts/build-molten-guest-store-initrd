#!/usr/bin/env bash
# Build a guest initrd from a pre-provisioned local Nix store copy.
set -euo pipefail
if [ "$#" -ne 5 ]; then
    echo "usage: $0 GUEST_OUTPUT NIX_BIN DRIVER SOURCE_TRUST OUT" >&2
    exit 2
fi
guest_output=$1
nix_bin=$2
driver=$3
trust=$4
out=$5
wrapper=${CHAOSCONTROL_MOLTEN_WRAPPER:-$(command -v chaoscontrol-molten-guest || true)}
[ -n "$wrapper" ] && [ -x "$wrapper" ] || { echo "wrapper missing" >&2; exit 2; }

mkdir -p "$out"
root=$(mktemp -d)
guestroot=$(mktemp -d)
trap 'chmod -R u+w "$root" "$guestroot" 2>/dev/null || true; rm -rf "$root" "$guestroot" || true' EXIT
mkdir -p "$root"/{dev,proc,sys,sys/kernel/debug,etc/molten,etc,root,usr/bin,data,tmp}
printf 'root:x:0:0:root:/root:/bin/sh\n' > "$root/etc/passwd"
printf 'root:x:0:\n' > "$root/etc/group"
cp "$wrapper" "$root/init"
cp "$driver" "$root/usr/bin/molten-collaborationnative"
cp "$trust" "$root/etc/molten/source-gate-trust.json"
if [ -n "${MOLTEN_GUEST_CLOSURE_CACHE:-}" ]; then
    cp "$MOLTEN_GUEST_CLOSURE_CACHE" "$root/etc/molten/source-closure-validation.json"
fi
chmod +x "$root/init" "$root/usr/bin/molten-collaborationnative"

# Copy the guest output, the verifier, and the measured runtime closure with signatures.
mapfile -t runtime < <(python3 - "$guest_output" <<'PY'
import json,sys
print("\n".join(p["path"] for p in json.load(open(sys.argv[1]+"/build-closure"))["paths"]))
PY
)
nix copy --to "local?root=$guestroot" --no-check-sigs "$guest_output" "$nix_bin" "${runtime[@]}"
cp -a "$guestroot/nix" "$root/nix"

for executable in "$root/init" "$driver"; do
    ldd "$executable" | awk '/=> \/nix\/store/{print $3}' | while IFS= read -r lib; do
        [ -e "$root$lib" ] && continue
        mkdir -p "$root$(dirname "$lib")"
        cp -L "$lib" "$root$lib"
    done
    interpreter=$(readelf -l "$executable" | sed -n 's/.*interpreter: \(.*\)\]/\1/p' | head -1)
    if [ -n "$interpreter" ] && [ -e "$interpreter" ] && [ ! -e "$root$interpreter" ]; then
        mkdir -p "$root$(dirname "$interpreter")"
        cp -L "$interpreter" "$root$interpreter"
    fi
done

if [ -n "${MOLTEN_GUEST_INITRD_UNCOMPRESSED:-}" ]; then
    (cd "$root" && find . -print0 | cpio --null -o -H newc --quiet) > "$out/initrd"
else
    (cd "$root" && find . -print0 | cpio --null -o -H newc --quiet) | gzip -9 > "$out/initrd"
fi
printf 'initrd=%s\n' "$out/initrd"
